{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "phpunit",
			"type": "shell",
			"command": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text --coverage-html ./coverage-report",
			"presentation": {
				"reveal": "always",
				"clear": true
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "php",
				"fileLocation": [
					"relative",
					"${workspaceRoot}"
				],
				"pattern": {
					"regexp": "^(.*?\\.php\\([0-9]+\\))\\s+(.*?)\\s+\\(\\s*(.*?)\\s*\\)$",
					"file": 1,
					"line": 2,
					"message": 3
				}
			}
		}
	]
}